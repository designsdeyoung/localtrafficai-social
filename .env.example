# Local Traffic AI: Instagram launch system
# Copy to .env and fill in. Never commit the real .env.

# --- Higgsfield (content/generate.js, REST mode only) ---------------------
# Agent mode needs no key. Only set this for: node content/generate.js --rest
HIGGSFIELD_API_KEY=
# Optional. Override only if the default API base 404s for your account.
HIGGSFIELD_API_BASE_URL=https://platform.higgsfield.ai/v1

# --- Instagram Graph API (automation/n8n-workflow.json) -------------------
# How to get these: see automation/SETUP.md, Part 4.
IG_BUSINESS_ID=
IG_ACCESS_TOKEN=

# Public base URL where content/assets/*.png are hosted (no trailing slash).
# Instagram fetches images from a public URL. See SETUP.md, Part 5.
ASSET_BASE_URL=https://CHANGE-ME.example.com/assets

# Full contents of content/calendar.json as a single string, OR skip this and
# wire a Read File node into the workflow instead. See SETUP.md, Part 6.
CALENDAR_JSON=
